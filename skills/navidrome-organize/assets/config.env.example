# navidrome-organize settings. Copy to ~/.config/navidrome-organize/config.env
# MusicBrainz and the Cover Art Archive need no key.

# AcoustID: identify files without usable tags. Also needs: brew install chromaprint
ACOUSTID_API_KEY=

# fanart.tv: artist images (artist.jpg).
FANARTTV_API_KEY=

# Largest side of cover.jpg and of the embedded cover, in pixels.
COVER_MAX=1500
EMBED_MAX=1000
# 1 embeds the cover in every file, 0 keeps only cover.jpg.
EMBED_COVER=1
