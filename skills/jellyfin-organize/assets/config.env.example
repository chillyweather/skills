# jellyfin-organize settings. Copy to ~/.config/jellyfin-organize/config.env

# TMDB: set one of the two.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Language for titles, plots, and episode names.
TMDB_LANGUAGE=en-US

# OpenSubtitles.com: needed only for subtitle downloads.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# The name of the API consumer you created, and a version.
OPENSUBTITLES_USER_AGENT=jellyfin-organize v1.0

# Subtitle languages to check for and download, comma separated.
SUB_LANGS=en,ru
